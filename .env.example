# نمونه‌ی فایل تنظیمات محیطی.
# برای راه‌اندازی، یک کپی از این فایل با نام .env بسازید و مقادیر واقعی را داخلش بگذارید.

# پورتی که سرور روی آن گوش می‌دهد
PORT=3000

# آدرسی که سرور روی آن گوش می‌دهد. 0.0.0.0 یعنی از همه سیستم‌های شبکه قابل دسترسی است.
HOST=0.0.0.0

# کلید رمزنگاری نشست کاربران — یک رشته تصادفی طولانی و مخفی.
# برای ساختن یک مقدار امن:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# مدت اعتبار نشست کاربر (به روز)
SESSION_MAX_AGE_DAYS=30

# آدرس دیتابیس MariaDB:  mysql://<کاربر>:<رمز>@<آدرس>:<پورت>/<دیتابیس>
# (install.bat این را خودکار می‌سازد؛ دیتابیس محلی روی پورت 3310)
DATABASE_URL=mysql://root:@127.0.0.1:3310/crm_template

# حداکثر اتصال‌های استخر دیتابیس
DB_CONNECTION_LIMIT=10

# محیط اجرا. برنامه نوع کوکی نشست را خودکار از HTTP/HTTPS درخواست تشخیص می‌دهد.
# NODE_ENV=production

# محدودسازی تلاش ورود (برای جلوگیری از حدس رمز عبور)
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10

# ===== CRM نمونه =====
# آدرس عمومی سایت برای لینک فرم احراز در پیامک (مثلاً https://crm.example.com)
PUBLIC_BASE_URL=
# پنل پیامک IPPanel — اگر خالی باشد، پیامک «دستی» آماده می‌شود تا کارشناس از گوشی بفرستد
IPPANEL_API_KEY=
IPPANEL_SENDER=
# توکن فرم همکاری سایت (وردپرس) برای POST /api/v1/public/intake با هدر X-Intake-Token (دست‌کم ۲۴ نویسه)
INTAKE_TOKEN=
# کلید امضای وب‌هوک وردست (از پنل وردست) — دریافت سرنخ اینستاگرام و سفارش در POST /api/v1/public/vardast
VARDAST_WEBHOOK_SECRET=

# خواندن فرم‌های همکاری از سایت (GET) — docs/site-forms-wordpress.php
SITE_FORMS_URL=https://crm.example.com/wp-json/crm-template/v1/entries
